# Copy this file to .env and fill in your MySQL details.
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456@puseletsoLEBOTO
DB_NAME=batloung_farm

# Browser origins allowed to call the API (comma-separated). Not needed when you use the
# Vite dev server, which proxies /api to this server.
CLIENT_ORIGIN=http://localhost:5173

# A fruit/size counts as low stock when its quantity is below this number.
LOW_STOCK_THRESHOLD=10

# Authentication: set strong unique values before starting the backend.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SALES_USERNAME=sales
SALES_PASSWORD=replace-with-a-strong-sales-password
